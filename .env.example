# ==============================================================================
# 美股量化雷达 (us-market-radar) · 环境变量模板（脱敏版）
# ==============================================================================
# 使用方法：
#   1) 复制本文件为 .env：            cp .env.example .env
#   2) 按需填入真实 Key；不填的模块会自动跳过（不会导致程序崩溃）；
#   3) .env 必须与 integrated_market_radar.py / discord_sentinel.py 放在同一目录；
#   4) .env 已被 .gitignore 排除，禁止提交到 Git / 公开仓库。
#
# ⚠️ 安全提示：
#   - 本文件是「占位模板」，所有值均为示例，禁止填入真实 Key 后提交；
#   - 生产机 .env 权限建议：chmod 600（仅服务运行用户可读）；
#   - 若 Key 曾出现在公开仓库/聊天记录，请立即到对应平台吊销并轮换；
#   - 只读/开源分发时，务必确认没有把真实 .env 打进压缩包。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1) Finnhub 实时行情（核心数据源；免费注册即可）
#    注册地址：https://finnhub.io/register
# ------------------------------------------------------------------------------
FINNHUB_API_KEY=your_finnhub_api_key_here

# ------------------------------------------------------------------------------
# 2) PushPlus 微信推送（可选；不填则跳过微信卡片推送）
#    注册地址：https://www.pushplus.plus/
# ------------------------------------------------------------------------------
PUSHPLUS_TOKEN=your_pushplus_token_here
PUSHPLUS_CHANNEL=clawbot

# ------------------------------------------------------------------------------
# 3) Discord Webhook（可选；不填则跳过 Discord 推送）
#    在 Discord 频道 → 编辑频道 → 整合 → Webhook 中创建并复制 URL
# ------------------------------------------------------------------------------
# 小豆泥量化哨兵主频道（51 只标的五梯队巡检 / 6 级状态机播报）
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_webhook_token
# 预警镜像频道（微信发什么同步发什么；兼容旧变量名 DISCORD_ALERT_WEBHOOK_URL）
DISCORD_CLAW_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_webhook_token
# 防御因子背离专属播报频道
DISCORD_DEFENSIVE_FLIGHT_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_webhook_token

# ------------------------------------------------------------------------------
# 4) GitHub 自动同步 Token（VPS / 本地以 --loop-daemon 自动 commit+push 时必需）
#    - 建议使用 Fine-grained PAT：仅授权本仓库，权限 Contents = Read and write
#    - 若使用 classic PAT：勾选 repo 即可
#    - GitHub Actions 云端环境内置 GITHUB_TOKEN，无需配置此项
#    - ⚠️ 该 Token 等同账号写权限，泄露后立即吊销
# ------------------------------------------------------------------------------
GH_TOKEN=ghp_your_github_personal_access_token_here

# ------------------------------------------------------------------------------
# 5) 可选运行参数（通常无需修改；systemd / Actions 会覆盖对应环境）
# ------------------------------------------------------------------------------
# 时区（影响日志与「实盘同步」提交时间显示；默认 Asia/Seoul 已在代码侧兜底）
# TZ=Asia/Seoul
# 守护进程轮询间隔秒数（实际以 --interval-seconds 命令行参数为准）
# RADAR_INTERVAL_SECONDS=120

# ------------------------------------------------------------------------------
# 6) 可选：ML 模型依赖（daemon 非必需；仅 ml_predictor_5y.py 训练/回测需要）
#    安装命令：pip install lightgbm scikit-learn pyarrow
# ------------------------------------------------------------------------------
# LIGHTGBM_DISABLE_GPU=1
